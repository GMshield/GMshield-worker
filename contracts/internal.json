{
  "components" : {
    "schemas" : {
      "ContractVersion" : {
        "properties" : {
          "version" : {
            "description" : "Version of the OpenAPI document",
            "example" : "1.0.0",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "Every error of this API (RFC 9457 problem detail).",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "code" : {
            "description" : "category.reason",
            "type" : "string"
          },
          "params" : {
            "additionalProperties" : true,
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "description" : "urn:gmshield:problem: followed by the code",
            "type" : "string"
          }
        },
        "required" : [ "category", "code", "params", "status", "title", "traceId", "type" ],
        "type" : "object"
      }
    }
  },
  "info" : {
    "title" : "GMshield internal API",
    "version" : "1.0.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/v1/version" : {
      "get" : {
        "operationId" : "getInternalContractVersion",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContractVersion"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The version of the internal API contract",
        "tags" : [ "contract" ]
      }
    }
  },
  "servers" : [ {
    "url" : "/"
  } ]
}
