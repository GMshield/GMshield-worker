{
  "components" : {
    "schemas" : {
      "ContractVersion" : {
        "properties" : {
          "version" : {
            "description" : "Version of the OpenAPI document",
            "example" : "1.0.0",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "JobClaim" : {
        "description" : "A live claim of a job. The grant is given once and never stored: only its keyed hash is.",
        "properties" : {
          "attempt" : {
            "description" : "1 for the first claim",
            "format" : "int32",
            "type" : "integer"
          },
          "claimId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "grant" : {
            "description" : "Send it in X-Job-Grant",
            "type" : "string"
          },
          "input" : {
            "additionalProperties" : { },
            "description" : "The handler's input for this attempt",
            "type" : "object"
          },
          "kind" : {
            "type" : "string"
          },
          "lapsesAt" : {
            "description" : "Without a renewal the claim lapses then",
            "format" : "date-time",
            "type" : "string"
          },
          "renewAt" : {
            "description" : "Renew the claim at this time",
            "format" : "date-time",
            "type" : "string"
          },
          "traceparent" : {
            "description" : "W3C traceparent of the job's trace: log under it and send it on every call",
            "type" : "string"
          }
        },
        "required" : [ "attempt", "claimId", "grant", "input", "kind", "lapsesAt", "renewAt", "traceparent" ],
        "type" : "object"
      },
      "JobOutcome" : {
        "description" : "How the claimed attempt ended.",
        "properties" : {
          "code" : {
            "description" : "For failed only: category.reason in lower case",
            "type" : "string"
          },
          "outcome" : {
            "enum" : [ "done", "failed" ],
            "type" : "string"
          },
          "result" : {
            "additionalProperties" : { },
            "description" : "For done only: the result for the job's handler",
            "type" : "object"
          }
        },
        "required" : [ "outcome" ],
        "type" : "object"
      },
      "JobRenewal" : {
        "description" : "The live claim's new times.",
        "properties" : {
          "lapsesAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "renewAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "lapsesAt", "renewAt" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "Every error of this API (RFC 9457 problem detail).",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "code" : {
            "description" : "category.reason",
            "type" : "string"
          },
          "params" : {
            "additionalProperties" : true,
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "description" : "urn:gmshield:problem: followed by the code",
            "type" : "string"
          }
        },
        "required" : [ "category", "code", "params", "status", "title", "traceId", "type" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "workerCredential" : {
        "description" : "The worker's credential (GMSHIELD_WORKER_CREDENTIAL); without it every path answers service.unauthenticated (401)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "GMshield internal API",
    "version" : "1.1.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/v1/jobs/{jobId}/claims" : {
      "post" : {
        "operationId" : "claimJob",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobClaim"
                }
              }
            },
            "description" : "Created"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Claim an offered job (409 job.claimed, 409 job.not_offered)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/outcome" : {
      "post" : {
        "operationId" : "reportJobOutcome",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JobOutcome"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Report how the claimed attempt ended (403 job.grant_refused)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/renewals" : {
      "post" : {
        "operationId" : "renewJobClaim",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobRenewal"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Renew a live claim (403 job.grant_refused)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/version" : {
      "get" : {
        "operationId" : "getInternalContractVersion",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContractVersion"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The version of the internal API contract",
        "tags" : [ "contract" ]
      }
    }
  },
  "security" : [ {
    "workerCredential" : [ ]
  } ],
  "servers" : [ {
    "url" : "/"
  } ]
}
