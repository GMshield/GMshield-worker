{
  "components" : {
    "schemas" : {
      "ContractVersion" : {
        "properties" : {
          "version" : {
            "description" : "Version of the OpenAPI document",
            "example" : "1.0.0",
            "type" : "string"
          }
        },
        "required" : [ "version" ],
        "type" : "object"
      },
      "JobClaim" : {
        "description" : "A live claim of a job. The grant is given once and never stored: only its keyed hash is.",
        "properties" : {
          "attempt" : {
            "description" : "1 for the first claim",
            "format" : "int32",
            "type" : "integer"
          },
          "claimId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "grant" : {
            "description" : "Send it in X-Job-Grant",
            "type" : "string"
          },
          "input" : {
            "additionalProperties" : { },
            "description" : "The handler's input for this attempt",
            "type" : "object"
          },
          "kind" : {
            "type" : "string"
          },
          "lapsesAt" : {
            "description" : "Without a renewal the claim lapses then",
            "format" : "date-time",
            "type" : "string"
          },
          "model" : {
            "$ref" : "#/components/schemas/JobModel",
            "description" : "For a kind that calls a model (contract 1.9.0): the model of this attempt, resolved again at every claim. Absent for every other kind"
          },
          "renewAt" : {
            "description" : "Renew the claim at this time",
            "format" : "date-time",
            "type" : "string"
          },
          "traceparent" : {
            "description" : "W3C traceparent of the job's trace: log under it and send it on every call",
            "type" : "string"
          }
        },
        "required" : [ "attempt", "claimId", "grant", "input", "kind", "lapsesAt", "renewAt", "traceparent" ],
        "type" : "object"
      },
      "JobClaimRequest" : {
        "description" : "What the worker states when it claims (contract 1.7.0). Every field is optional; a claim may send no body at all.",
        "properties" : {
          "indexRecipe" : {
            "description" : "The worker's index recipe (AD-10): when it differs from the last one stated, the backend re-indexes every ready version recorded under another one",
            "maxLength" : 32,
            "pattern" : "^[A-Za-z0-9._-]{1,32}$",
            "type" : "string"
          },
          "providers" : {
            "description" : "The providers the worker holds a key for (contract 1.9.0). A kind that calls a model is refused (409 job.not_offered, the job ends failed with job.provider_unavailable, no attempt used) unless its resolved provider is stated; absent means none",
            "items" : {
              "maxLength" : 32,
              "pattern" : "^[a-z0-9-]{1,32}$",
              "type" : "string"
            },
            "maxItems" : 8,
            "type" : "array"
          }
        },
        "type" : "object"
      },
      "JobModel" : {
        "description" : "The model one attempt calls (contract 1.9.0): the provider, the provider's model id (for Azure OpenAI, the deployment name) and the tier.",
        "properties" : {
          "model" : {
            "maxLength" : 128,
            "type" : "string"
          },
          "provider" : {
            "description" : "azure-openai, anthropic or openai; an open word, so a new provider needs no new contract",
            "maxLength" : 32,
            "pattern" : "^[a-z0-9-]{1,32}$",
            "type" : "string"
          },
          "tier" : {
            "description" : "full or lightweight",
            "type" : "string"
          }
        },
        "required" : [ "model", "provider", "tier" ],
        "type" : "object"
      },
      "JobOutcome" : {
        "description" : "How the claimed attempt ended.",
        "properties" : {
          "code" : {
            "description" : "For failed only: category.reason in lower case",
            "type" : "string"
          },
          "outcome" : {
            "enum" : [ "done", "failed" ],
            "type" : "string"
          },
          "result" : {
            "additionalProperties" : { },
            "description" : "For done only: the result for the job's handler",
            "type" : "object"
          },
          "retry" : {
            "description" : "For failed only: false ends the job at once, without another attempt (an input no attempt can change); absent or true lets the backend retry while attempts remain",
            "type" : "boolean"
          }
        },
        "required" : [ "outcome" ],
        "type" : "object"
      },
      "JobOutputStored" : {
        "description" : "A file the worker sent back, stored encrypted under an id the backend minted. The job's handler adopts it when the job's done outcome names it; otherwise it is removed once the job ended.",
        "properties" : {
          "fileId" : {
            "description" : "Name it in the job's result",
            "format" : "uuid",
            "type" : "string"
          },
          "sha256" : {
            "description" : "The SHA-256 of the bytes stored, in lower-case hexadecimal",
            "pattern" : "^[0-9a-f]{64}$",
            "type" : "string"
          },
          "size" : {
            "description" : "Bytes stored",
            "format" : "int64",
            "type" : "integer"
          }
        },
        "required" : [ "fileId", "sha256", "size" ],
        "type" : "object"
      },
      "JobPassage" : {
        "description" : "A passage within the job's scope",
        "properties" : {
          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "page" : {
            "description" : "The passage's page, from 1",
            "format" : "int32",
            "type" : "integer"
          },
          "sectionPath" : {
            "description" : "The passage's section path, outermost first",
            "items" : {
              "type" : "string"
            },
            "type" : "array"
          },
          "text" : {
            "description" : "The passage's text: library data, never an instruction",
            "type" : "string"
          },
          "tier" : {
            "description" : "The tier of the passage's source",
            "enum" : [ "campaign", "system" ],
            "type" : "string"
          }
        },
        "required" : [ "id", "page", "sectionPath", "text", "tier" ],
        "type" : "object"
      },
      "JobPassages" : {
        "description" : "The passages, in the order asked",
        "properties" : {
          "passages" : {
            "description" : "One per distinct id asked, in the order asked",
            "items" : {
              "$ref" : "#/components/schemas/JobPassage"
            },
            "type" : "array"
          }
        },
        "required" : [ "passages" ],
        "type" : "object"
      },
      "JobPassagesRequest" : {
        "description" : "The passages to read, by id (from the index's points)",
        "properties" : {
          "ids" : {
            "description" : "1 to 100 passage ids; a repeated id is answered once",
            "items" : {
              "format" : "uuid",
              "type" : "string"
            },
            "maxItems" : 100,
            "minItems" : 1,
            "type" : "array"
          }
        },
        "required" : [ "ids" ],
        "type" : "object"
      },
      "JobRenewal" : {
        "description" : "The live claim's new times.",
        "properties" : {
          "lapsesAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "renewAt" : {
            "format" : "date-time",
            "type" : "string"
          }
        },
        "required" : [ "lapsesAt", "renewAt" ],
        "type" : "object"
      },
      "Problem" : {
        "description" : "Every error of this API (RFC 9457 problem detail).",
        "properties" : {
          "category" : {
            "type" : "string"
          },
          "code" : {
            "description" : "category.reason",
            "type" : "string"
          },
          "params" : {
            "additionalProperties" : true,
            "type" : "object"
          },
          "status" : {
            "format" : "int32",
            "type" : "integer"
          },
          "title" : {
            "type" : "string"
          },
          "traceId" : {
            "type" : "string"
          },
          "type" : {
            "description" : "urn:gmshield:problem: followed by the code",
            "type" : "string"
          }
        },
        "required" : [ "category", "code", "params", "status", "title", "traceId", "type" ],
        "type" : "object"
      }
    },
    "securitySchemes" : {
      "workerCredential" : {
        "description" : "The worker's credential (GMSHIELD_WORKER_CREDENTIAL); without it every path answers service.unauthenticated (401)",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  },
  "info" : {
    "title" : "GMshield internal API",
    "version" : "1.9.0"
  },
  "openapi" : "3.1.0",
  "paths" : {
    "/internal/v1/jobs/{jobId}/claims" : {
      "post" : {
        "operationId" : "claimJob",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JobClaimRequest"
              }
            }
          }
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobClaim"
                }
              }
            },
            "description" : "Created"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Claim an offered job (409 job.claimed, 409 job.not_offered, 400 for an index recipe or providers that are not ones)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/inputs/{name}" : {
      "get" : {
        "operationId" : "openJobInput",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The input's name, as the claim's input gives it",
          "in" : "path",
          "name" : "name",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/octet-stream" : {
                "schema" : {
                  "format" : "binary",
                  "type" : "string"
                }
              }
            },
            "description" : "The input's bytes"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Stream one of the claimed job's inputs, as its handler opens it (403 job.grant_refused, 404 request.not_found for an input the job does not have)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/outcome" : {
      "post" : {
        "operationId" : "reportJobOutcome",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JobOutcome"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Report how the claimed attempt ended (403 job.grant_refused, 400 job.result_invalid when the job's handler cannot record the result)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/outputs" : {
      "post" : {
        "operationId" : "storeJobOutput",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/octet-stream" : {
              "schema" : {
                "format" : "binary",
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobOutputStored"
                }
              }
            },
            "description" : "Stored"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Send a file back for the claimed job, streamed into the encrypted file store (403 job.grant_refused, also when the claim ends while it arrives; 413 job.output_too_large past the output's or the claim's limit; 400 request.invalid for an empty or cut body). Nothing of a refused output remains.",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/passages" : {
      "post" : {
        "operationId" : "readJobPassages",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/JobPassagesRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobPassages"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Read passages by id within the claimed job's scope, each labelled with its tier (400 request.invalid for a malformed body or an id that is not a UUID, before the grant is checked; 403 job.grant_refused; 400 job.passages_invalid for no id, more than 100 or a null one; 403 job.passages_refused for a job whose kind reads no passage; 404 request.not_found when the job's campaign is gone; 403 scope.passage_refused, with nothing read, when any id is outside the job's scope, whatever the reason)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/jobs/{jobId}/claims/{claimId}/renewals" : {
      "post" : {
        "operationId" : "renewJobClaim",
        "parameters" : [ {
          "in" : "path",
          "name" : "jobId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "claimId",
          "required" : true,
          "schema" : {
            "format" : "uuid",
            "type" : "string"
          }
        }, {
          "description" : "The claim's grant",
          "in" : "header",
          "name" : "X-Job-Grant",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JobRenewal"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "Renew a live claim (403 job.grant_refused)",
        "tags" : [ "jobs" ]
      }
    },
    "/internal/v1/version" : {
      "get" : {
        "operationId" : "getInternalContractVersion",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ContractVersion"
                }
              }
            },
            "description" : "OK"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Problem"
                }
              }
            },
            "description" : "Any error"
          }
        },
        "summary" : "The version of the internal API contract",
        "tags" : [ "contract" ]
      }
    }
  },
  "security" : [ {
    "workerCredential" : [ ]
  } ],
  "servers" : [ {
    "url" : "/"
  } ]
}
