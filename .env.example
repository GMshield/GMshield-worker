# Every setting the worker reads. README.md ("Settings") explains each.
# Nothing loads this file on its own: on roberto-server the pipeline injects
# ~/gmshield-ci/secrets/worker.env, written by GMshield-pipeline deploy/data-credentials.sh. To run by
# hand, copy it to .env (git-ignored), fill in the secrets and pass it with `docker run --env-file .env`.
# For the whole application, use the shared development setup in GMshield-backend/dev instead.
# Secrets are left empty here and never committed.

# The backend's address, http or https, without credentials (required outside test mode)
GMSHIELD_BACKEND_URL=http://gmshield-backend:8080

# The worker's credential for /internal/v1, the same value as the backend's (required outside test
# mode; secret): 32 to 512 characters of A-Z a-z 0-9 . _ ~ + / = -
GMSHIELD_WORKER_CREDENTIAL=

# The model provider's key (required outside test mode; secret)
GMSHIELD_ANTHROPIC_API_KEY=

# Redis (TLS verified against /run/gmshield/certs/ca.crt; false only in the development setup)
GMSHIELD_REDIS_HOST=redis
GMSHIELD_REDIS_PORT=6379
GMSHIELD_REDIS_USERNAME=worker
GMSHIELD_REDIS_PASSWORD=
GMSHIELD_REDIS_TLS=true

# Interactive jobs at once, 1 to 16 (the ingestion lane runs one)
GMSHIELD_INTERACTIVE_CAPACITY=2

# Absolute; production mounts the named volume gmshield-worker-work here
GMSHIELD_WORK_DIR=/var/lib/gmshield-worker/work

# Only for tests that run the worker outside the image
# GMSHIELD_HEALTH_FILE=/run/gmshield-worker/healthy

# Unset, or `test` (set only by the pipeline; it needs no secret)
# GMSHIELD_MODE=test
